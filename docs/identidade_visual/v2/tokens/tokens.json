{
  "$description": "Tokens de design do Ravix v2. Unidades: dp/sp no app, px no site (1dp = 1px CSS).",
  "color": {
    "brand": {
      "floresta": "#163730",
      "menta": "#78CFA5",
      "menta600": "#3FB282",
      "petroleo": "#22727B",
      "areia": "#C9AD78",
      "nevoa": "#EEF4F0",
      "tinta": "#0C2420"
    },
    "status": {
      "ok": "#3FB282",
      "atencao": "#D9A441",
      "estourado": "#D0614E"
    },
    "light": {
      "background": "#F4F7F4",
      "surface": "#FFFFFF",
      "surfaceAlt": "#E9F0EC",
      "text": "#11241F",
      "textMuted": "#5B6F69",
      "line": "#D2DFD8",
      "primary": "#163730",
      "onPrimary": "#EEF4F0",
      "accent": "#3FB282",
      "accentFill": "#78CFA5",
      "onAccentFill": "#0C2420",
      "info": "#22727B",
      "category": "#C9AD78"
    },
    "dark": {
      "background": "#0D1C19",
      "surface": "#132823",
      "surfaceAlt": "#1B3530",
      "text": "#E7F0EC",
      "textMuted": "#93A9A2",
      "line": "#244038",
      "primary": "#78CFA5",
      "onPrimary": "#0C2420",
      "accent": "#78CFA5",
      "accentFill": "#78CFA5",
      "onAccentFill": "#0C2420",
      "info": "#6CC1C8",
      "category": "#C9AD78"
    },
    "chart": ["#78CFA5", "#22727B", "#C9AD78", "#4FA3A0", "#163730", "#A9C9BC"]
  },
  "font": {
    "display": { "family": "Chakra Petch", "weights": [500, 600, 700] },
    "text": { "family": "Archivo", "weights": [400, 500, 600] },
    "values": { "family": "Ravix Valores", "weights": [600, 700], "note": "Derivada da Chakra Petch com dígitos de largura igual. Só para valores em dinheiro no app. No site: Archivo com tabular-nums." }
  },
  "type": {
    "mobile_sp": {
      "valorDestaque": { "font": "display", "weight": 700, "size": 40, "lineHeight": 44, "tracking": -0.02 },
      "tituloTela":    { "font": "display", "weight": 700, "size": 24, "lineHeight": 28, "tracking": -0.01 },
      "secao":         { "font": "display", "weight": 600, "size": 18, "lineHeight": 24, "tracking": 0 },
      "valorLista":    { "font": "display", "weight": 600, "size": 16, "lineHeight": 20, "tracking": 0 },
      "corpo":         { "font": "text", "weight": 400, "size": 16, "lineHeight": 24, "tracking": 0 },
      "rotulo":        { "font": "text", "weight": 500, "size": 14, "lineHeight": 20, "tracking": 0 },
      "legenda":       { "font": "text", "weight": 500, "size": 12, "lineHeight": 16, "tracking": 0.01 },
      "sobretitulo":   { "font": "text", "weight": 600, "size": 11, "lineHeight": 16, "tracking": 0.1, "uppercase": true }
    },
    "web_px": {
      "display": { "font": "display", "weight": 700, "size": 64, "lineHeight": 66, "tracking": -0.03, "mobileSize": 40 },
      "h1":      { "font": "display", "weight": 700, "size": 44, "lineHeight": 48, "tracking": -0.02, "mobileSize": 32 },
      "h2":      { "font": "display", "weight": 700, "size": 32, "lineHeight": 36, "tracking": -0.02, "mobileSize": 26 },
      "h3":      { "font": "display", "weight": 600, "size": 22, "lineHeight": 28, "tracking": -0.01 },
      "lead":    { "font": "text", "weight": 400, "size": 19, "lineHeight": 30 },
      "body":    { "font": "text", "weight": 400, "size": 17, "lineHeight": 27 },
      "small":   { "font": "text", "weight": 500, "size": 14, "lineHeight": 20 }
    }
  },
  "space": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40, "12": 48, "16": 64, "24": 96 },
  "shape": {
    "$description": "Cantos chanfrados a 45°. Compose: CutCornerShape(n.dp). Flutter: BeveledRectangleBorder(borderRadius: BorderRadius.circular(n)). SwiftUI: shape customizado. Web: clip-path.",
    "chanfroP": 4,
    "chanfroM": 8,
    "chanfroG": 12,
    "uso": {
      "chip": "chanfroP",
      "campo": "chanfroM",
      "botao": "chanfroM",
      "fab": "chanfroG",
      "card": "chanfroG",
      "iconeCategoria": "chanfroP"
    }
  },
  "size": {
    "toqueMinimo": 48,
    "botaoAltura": 52,
    "campoAltura": 56,
    "itemLista": 64,
    "iconeCategoria": 36,
    "icone": 24,
    "iconeTraco": 2
  },
  "icon": {
    "style": "Traço de 2dp, pontas retas (linecap square) e junções em ângulo (linejoin miter). Sem cantos arredondados."
  },
  "motion": {
    "rapido": "120ms cubic-bezier(.2,.8,.2,1)",
    "padrao": "220ms cubic-bezier(.2,.8,.2,1)",
    "enfase": "420ms cubic-bezier(.2,.8,.2,1)"
  }
}
